{
  "name": "decky-builds",
  "version": "0.1.0",
  "description": "Decky Loader plugin: controller-first game guides and build sheets uploaded as JSON",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:mock": "DECKY_BUILDS_MOCK=1 rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node dev/preview/build.mjs && echo \"Open dev/preview/index.html through a local web server, e.g. python3 -m http.server -d dev/preview\""
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "guides"
  ],
  "author": "Felix",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "esbuild": "0.21.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
